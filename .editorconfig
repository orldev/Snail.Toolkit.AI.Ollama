root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# --- Structure ---------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# --- Modern idioms -----------------------------------------------------------
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_style_collection_initializer = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# --- Naming: PascalCase members, camelCase locals/params, _camelCase fields --
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.types_and_namespaces.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.visible_members.applicable_kinds = property, method, event, field
dotnet_naming_symbols.visible_members.applicable_accessibilities = public, internal, protected, protected_internal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I
dotnet_naming_style.t_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.t_prefix_pascal.required_prefix = T
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_rule.type_parameters_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_start_with_t.style = t_prefix_pascal
dotnet_naming_rule.type_parameters_start_with_t.severity = warning

dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = warning

dotnet_naming_rule.private_static_readonly_are_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_are_pascal.style = pascal_case
dotnet_naming_rule.private_static_readonly_are_pascal.severity = warning

dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore_camel.severity = warning

dotnet_naming_rule.types_are_pascal.symbols = types_and_namespaces
dotnet_naming_rule.types_are_pascal.style = pascal_case
dotnet_naming_rule.types_are_pascal.severity = warning

dotnet_naming_rule.visible_members_are_pascal.symbols = visible_members
dotnet_naming_rule.visible_members_are_pascal.style = pascal_case
dotnet_naming_rule.visible_members_are_pascal.severity = warning

dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel_case
dotnet_naming_rule.locals_and_parameters_are_camel.severity = warning
