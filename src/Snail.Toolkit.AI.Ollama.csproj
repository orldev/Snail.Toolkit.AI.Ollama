<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Snail.Toolkit.AI.Ollama</PackageId>
        <Title>Snail.Toolkit.AI.Ollama</Title>
        <Description>Microsoft.Extensions.AI provider for Ollama's native API: chat with tool calling, NDJSON streaming, embeddings, thinking and multimodal input.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.AI.Ollama</RepositoryUrl>
        <Copyright>Toolkit, 2023</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.AI.Ollama</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <SnailNotNativeBecause>Requests and answers go through Snail.Toolkit.HttpBuilder.Extensions 0.3.0, which reads and writes JSON by reflection: under Native AOT the first chat throws. Native once HttpBuilder takes JsonTypeInfo overloads and this library a source-generated JSON context (the audit, B.md: O3, O4).</SnailNotNativeBecause>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.Toolkit.AI.Ollama.Tests" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.AI" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Http" />
      <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
      <PackageReference Include="Microsoft.Extensions.Options" />
      <PackageReference Include="Snail.Toolkit.HttpBuilder.Extensions" />
    </ItemGroup>

</Project>
