<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Snail.Toolkit.AI.Ollama</PackageId>
        <Title>Snail.Toolkit.AI.Ollama</Title>
        <Description>Microsoft.Extensions.AI provider for Ollama's native API: chat with tool calling, NDJSON streaming, embeddings, thinking and multimodal input.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.AI.Ollama</RepositoryUrl>
        <Copyright>Toolkit, 2023</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.AI.Ollama</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <!--
      Settings are bound by the configuration binding source generator, not by reflection: OllamaOptions has
      only set properties, which the generator binds.
    -->
    <PropertyGroup>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.Toolkit.AI.Ollama.Tests" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.AI" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Http" />
      <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
      <PackageReference Include="Microsoft.Extensions.Options" />
      <PackageReference Include="Snail.Toolkit.HttpBuilder.Extensions" />
    </ItemGroup>

</Project>
